# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production: https://virtuousvogue.com (used for canonical links and link-preview images; falls back to the Vercel URL)
NEXT_PUBLIC_WHATSAPP_NUMBER=            # digits only, e.g. 237675741245. Defaults to the studio number in src/lib/site.ts.
NEXT_PUBLIC_BOOKING_MODE=whatsapp       # whatsapp (default): booking requests go to the stylist on WhatsApp. online: on-site confirmation + payments.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=           # privacy-conscious analytics; empty disables

# feature flags
NEXT_PUBLIC_FEATURE_EDIT=false          # curated retail at /edit
NEXT_PUBLIC_FEATURE_GROUP=false         # group consultations
NEXT_PUBLIC_FEATURE_INTL_CARDS=false
NEXT_PUBLIC_FEATURE_CURSOR=true

# ---------------------------------------------------------------- supabase
# Leave empty to run fully local (JSON store in .data/, signed dev sessions).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_SESSION_SECRET=change-me-in-dev
LOCAL_ADMIN_EMAIL=                      # local mode: which email becomes the admin (default: first sign-in)
ALLOW_LOCAL_STORE=false                 # never true in production

# ---------------------------------------------------------------- email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Virtuous Vogue <hello@yourdomain.com>"
STYLIST_NOTIFICATION_EMAIL=             # cockpit notifications for bookings, leads and Ask VV

# ---------------------------------------------------------------- booking
CALCOM_API_KEY=                         # optional: mirrors bookings to Cal.com and pulls busy times
CALCOM_USERNAME=
CALCOM_API_URL=https://api.cal.com/v2
CRON_SECRET=                            # protects /api/cron/reminders

# ---------------------------------------------------------------- payments (provider abstraction)
PAYMENTS_LOCAL_PROVIDER=                # campay | flutterwave (auto-detected when empty)
CAMPAY_PERMANENT_TOKEN=
CAMPAY_WEBHOOK_KEY=
CAMPAY_BASE_URL=https://www.campay.net/api
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=                      # international cards (optional)
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- AI & imaging
AI_PROVIDER=heuristic                   # heuristic | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
BG_REMOVAL_PROVIDER=none                # none | remove_bg | photoroom
REMOVE_BG_API_KEY=
PHOTOROOM_API_KEY=
